# Copy this file to .env and fill in your real values.
# .env is gitignored and must never be committed.
#
# The values below are placeholders only — replace every one of
# them with your own device/account details before running the app.

# ── Face Recognition Device (FTP) ──────────────────────────────
DEVICE_IP=0.0.0.0
FTP_PORT=0
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password

# ── Google Sheets ───────────────────────────────────────────────
# The Sheet ID is the long string in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your_google_sheet_id

# ── Telegram Notifications (optional) ───────────────────────────
ENABLE_TELEGRAM=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
